{
  "name": "vamp-mcp",
  "version": "0.3.11",
  "description": "Run AI computer-use agents in VMs on your own hardware. VM lifecycle, GUI automation, and saved RPA replay over MCP.",
  "type": "module",
  "license": "MIT",
  "author": "wayfarer6",
  "repository": {
    "type": "git",
    "url": "https://github.com/wayfarer6/vamp-mcp.git",
    "directory": "npm-package"
  },
  "homepage": "https://github.com/wayfarer6/vamp-mcp#readme",
  "bugs": {
    "url": "https://github.com/wayfarer6/vamp-mcp/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "vamp-mcp": "bin/vamp-mcp.mjs"
  },
  "files": [
