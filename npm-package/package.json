{
  "name": "vamp-mcp",
  "version": "0.2.3",
  "description": "Packer-powered VM installation, post-install setup, golden image management and GUI automation over MCP for VirtualBox, KVM and Hyper-V.",
  "type": "module",
  "license": "MIT",
  "author": "wayfarer6",
  "repository": {
    "type": "git",
    "url": "https://github.com/wayfarer6/vamp-mcp.git",
    "directory": "npm-package"
  },
  "homepage": "https://github.com/wayfarer6/vamp-mcp#readme",
  "bugs": {
    "url": "https://github.com/wayfarer6/vamp-mcp/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "vamp-mcp": "bin/vamp-mcp.mjs"
  },
  "files": [
    "bin/",
    "runtime/",
    "notices/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "virtualbox",
    "kvm",
    "virtual-machine",
