{
  "name": "vamp-mcp",
  "displayName": "VAMP — Virtual Agent Machine Platform",
  "description": "VM-isolated GUI RPA & Encrypted Vault Execution for AI Agents",
  "version": "0.1.5",
  "publisher": "wayfarer6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wayfarer6/vamp-mcp.git"
  },
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "MCP",
    "VM",
    "VNC",
    "RPA",
    "AI agent",
    "VAMP"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "vamp.setupPython",
        "title": "VAMP: Set Up Python Environment"
      },
      {
        "command": "vamp.openGuide",
        "title": "VAMP: Open Setup Guide"
      },
      {
        "command": "vamp.createVM",
        "title": "VAMP: Create VM From ISO"
      },
      {
        "command": "vamp.onboard",
        "title": "VAMP: First-Time VM Setup"
      },
      {
        "command": "vamp.openKvmViewer",
        "title": "VAMP: Open KVM Viewer (Live VNC)"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "vamp.virtualbox",
        "label": "VAMP VirtualBox"
      },
      {
        "id": "vamp.kvm",
        "label": "VAMP KVM (VNC)"
      }
    ],
    "configuration": {
      "title": "VAMP",
      "properties": {
        "vamp.pythonExecutable": {
          "type": "string",
          "default": "",
          "description": "Optional host Python executable path. Otherwise detect Python 3 automatically."
        },
        "vamp.vboxManagePath": {
          "type": "string",
          "default": "",
          "description": "Optional VBoxManage executable path."
        },
        "vamp.mousePythonExecutable": {
          "type": "string",
          "default": "",
          "description": "Optional host Python with VirtualBox SDK vboxapi for mouse input."
        },
        "vamp.kvmRepositoryPath": {
          "type": "string",
          "default": "",
          "description": "Local VAMP repository containing vm_mcp_server.py. KVM uses the shared VNC display."
        },
        "vamp.kvmPythonExecutable": {
          "type": "string",
          "default": "",
          "description": "KVM MCP Python with requirements-mcp.txt installed. Defaults to the repository .venv."
        },
        "vamp.kvmConfigPath": {
          "type": "string",
          "default": "",
          "description": "Optional VM profile JSON for the KVM MCP server. Defaults to config/vm-mcp.json in the repository."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "npm run build && vsce package --out ../artifacts/vamp-mcp-0.1.5.vsix",
    "vscode:prepublish": "npm run build",
    "test:viewer": "node --test test/viewer-bridge.mjs"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.25.0"
  },
  "preview": false,
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  },
  "icon": "icon.png",
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "ws": "^8.23.0"
  }
}
