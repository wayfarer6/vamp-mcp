{
  "name": "vamp-mcp",
  "displayName": "VAMP \u2014 Virtual Agent Machine Platform",
  "description": "VM-isolated GUI RPA & Encrypted Vault Execution for AI Agents",
  "version": "0.1.6",
  "publisher": "wayfarer6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wayfarer6/vamp-mcp.git"
  },
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "MCP",
    "VM",
    "VNC",
    "RPA",
    "AI agent",
    "VAMP"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "vamp.openRpaLibrary",
        "title": "VAMP: Find and Export RPA",
        "icon": "$(library)"
      },
      {
        "command": "vamp.openVault",
        "title": "VAMP: Browse Credentials"
      },
      {
        "command": "vamp.openManager",
        "title": "VAMP: Open VM Manager",
        "icon": "$(vm)"
      },
      {
        "command": "vamp.openVmScreen",
        "title": "VAMP: View VM Screen"
      },
      {
        "command": "vamp.setupPython",
        "title": "VAMP: Set Up Python Environment"
      },
      {
        "command": "vamp.openGuide",
        "title": "VAMP: Open Setup Guide"
      },
      {
        "command": "vamp.createVM",
        "title": "VAMP: Create VM From ISO"
      },
      {
        "command": "vamp.onboard",
        "title": "VAMP: First-Time VM Setup"
      },
      {
        "command": "vamp.openKvmViewer",
        "title": "VAMP: Open KVM Viewer (Live VNC)"
      },
      {
        "command": "vamp.verifyEnvironment",
        "title": "VAMP: Verify Python Environment (Activation and Imports)"
      },
      {
        "command": "vamp.removePython",
        "title": "VAMP: Delete Python Environment"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "vamp.virtualbox",
        "label": "VAMP VirtualBox"
      },
      {
        "id": "vamp.kvm",
        "label": "VAMP KVM (VNC)"
      },
      {
        "id": "vamp.library",
        "label": "VAMP RPA Library"
      }
    ],
    "configuration": {
      "title": "VAMP",
      "properties": {
        "vamp.pythonExecutable": {
          "type": "string",
          "default": "",
          "description": "Optional host Python executable path. Otherwise detect Python 3 automatically."
        },
        "vamp.vboxManagePath": {
          "type": "string",
          "default": "",
          "description": "Optional VBoxManage executable path."
        },
        "vamp.mousePythonExecutable": {
          "type": "string",
          "default": "",
          "description": "Optional host Python with VirtualBox SDK vboxapi for mouse input."
        },
        "vamp.kvmRepositoryPath": {
          "type": "string",
          "default": "",
          "description": "Local VAMP repository containing vm_mcp_server.py. KVM uses the shared VNC display."
        },
        "vamp.kvmPythonExecutable": {
          "type": "string",
          "default": "",
          "description": "KVM MCP Python with requirements-mcp.txt installed. Defaults to the repository .venv."
        },
        "vamp.kvmConfigPath": {
          "type": "string",
          "default": "",
          "description": "Optional VM profile JSON for the KVM MCP server. Defaults to config/vm-mcp.json in the repository."
        },
        "vamp.libvirtUri": {
          "type": "string",
          "default": "qemu:///session",
          "enum": [
            "qemu:///session",
            "qemu:///system"
          ],
          "description": "Local KVM connection used by VM Manager. Session runs VMs as your user; system requires libvirt permissions."
        },
        "vamp.rpaDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional host folders containing VM recordings or RPA packages. You can also add them from RPA Library."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vamp",
          "title": "VAMP",
          "icon": "assets/sidebar-brand.png"
        }
      ]
    },
    "views": {
      "vamp": [
        {
          "id": "vamp.desktops",
          "name": "Virtual Desktops",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "vamp.openRpaLibrary",
          "when": "view == vamp.desktops",
          "group": "navigation@0"
        },
        {
          "command": "vamp.openManager",
          "when": "view == vamp.desktops",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "npm run build && vsce package --out ../artifacts/vamp-mcp-0.1.6.vsix",
    "vscode:prepublish": "npm run build",
    "test:viewer": "node --test test/viewer-bridge.mjs",
    "test:manager": "node --test test/vm-manager.cjs test/host-backends.cjs test/library-store.cjs test/rpa-author.cjs"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.25.0"
  },
  "preview": false,
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  },
  "icon": "icon.png",
  "dependencies": {
    "@novnc/novnc": "^1.7.0",
    "ws": "^8.23.0",
    "yazl": "3.3.1"
  }
}
