{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SPICE RPA package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "id",
    "name",
    "version",
    "default_entrypoint",
    "entrypoints",
    "python_libraries",
    "dependencies",
    "skill",
    "outputs"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "default_entrypoint": {
      "type": "string"
    },
    "skill": {
      "type": "string"
    },
    "python_libraries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "\\.py$"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "file",
          "credentials"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "pattern": "\\.robot$"
          },
          "credentials": {
            "enum": [
              "none",
              "environment_or_prompt",
              "public_sandbox_config"
            ]
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "robot_log",
        "robot_report"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "robot_log": {
          "type": "string"
        },
        "robot_report": {
          "type": "string"
        }
      }
    }
  }
}
