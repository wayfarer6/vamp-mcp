{
  "format_version": 1,
  "id": "windows_naver_recorded",
  "name": "Windows 네이버 로그인 화면 접근 (수동 기록 변환)",
  "version": "0.1.0",
  "default_entrypoint": "run",
  "entrypoints": [
    {
      "name": "run",
      "file": "run.robot",
      "credentials": "environment_or_prompt"
    }
  ],
  "python_libraries": [
    "workflow.py"
  ],
  "dependencies": [
    "spice",
    "yolo",
    "paddleocr"
  ],
  "skill": "spice-recording-convert",
  "outputs": {
    "summary": "${OUTPUT DIR}/summary.json",
    "robot_log": "${OUTPUT DIR}/log.html",
    "robot_report": "${OUTPUT DIR}/report.html"
  }
}
