{
  "format_version": 1,
  "id": "desktop_control",
  "name": "게스트 화면과 입력 제어",
  "version": "1.0.0",
  "default_entrypoint": "run",
  "entrypoints": [
    {
      "name": "run",
      "file": "run.robot",
      "credentials": "none"
    }
  ],
  "python_libraries": [
    "workflow.py"
  ],
  "dependencies": [
    "spice"
  ],
  "skill": "spice-vm-rpa",
  "outputs": {
    "summary": "${OUTPUT DIR}/summary.json",
    "robot_log": "${OUTPUT DIR}/log.html",
    "robot_report": "${OUTPUT DIR}/report.html"
  }
}
