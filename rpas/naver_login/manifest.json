{
  "format_version": 1,
  "id": "naver_login",
  "name": "네이버 로그인",
  "version": "1.0.0",
  "default_entrypoint": "run",
  "entrypoints": [
    {
      "name": "run",
      "file": "run.robot",
      "credentials": "none"
    },
    {
      "name": "login",
      "file": "login.robot",
      "credentials": "environment_or_prompt"
    }
  ],
  "python_libraries": [
    "workflow.py"
  ],
  "dependencies": [
    "spice",
    "yolo",
    "paddleocr"
  ],
  "skill": "spice-naver-login",
  "outputs": {
    "summary": "${OUTPUT DIR}/summary.json",
    "robot_log": "${OUTPUT DIR}/log.html",
    "robot_report": "${OUTPUT DIR}/report.html"
  }
}
