# Build after the common desktop image. Override with a verified base digest for release builds.
ARG VAMP_DESKTOP_BASE=localhost/vamp-debian-desktop:dev
FROM ${VAMP_DESKTOP_BASE}
LABEL org.opencontainers.image.title="VAMP Debian Desktop - AMD" \
      org.opencontainers.image.description="Optional Mesa graphics userspace; requires an approved AMD render device"
USER 0:0
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-dri libegl-mesa0 mesa-vulkan-drivers mesa-va-drivers \
    libvulkan1 mesa-utils vulkan-tools vainfo \
    && rm -rf /var/lib/apt/lists/*
# No host drivers, firmware, ROCm, device nodes, or default GPU selection.
USER 1000:1000
