{
  "name": "vamp-vault",
  "displayName": "VAMP Vault \u2014 Credential & Certificate Isolation for AI Agents",
  "description": "Local & remote (SSH) encrypted vault isolation (KeePassXC & VeraCrypt) with strict per-host credential boundaries for AI agents",
  "version": "0.1.10",
  "publisher": "wayfarer6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wayfarer6/vamp-mcp.git",
    "directory": "vscode-vault-extension"
  },
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "MCP",
    "vault",
    "KeePassXC",
    "VeraCrypt",
    "credentials",
    "certificate",
    "NPKI",
    "AI agent",
    "VAMP",
    "remote",
    "SSH",
    "isolation"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./extension.js",
  "icon": "icon.png",
  "activationEvents": [
    "onStartupFinished",
    "onView:vampVault.views.credentials",
    "onView:vampVault.views.status"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "extensionDependencies": [
    "wayfarer6.vamp-mcp-tools"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vamp-vault",
          "title": "VAMP Vault",
          "icon": "assets/vault.svg"
        }
      ]
    },
    "views": {
      "vamp-vault": [
        {
          "id": "vampVault.views.status",
          "name": "Vault Status",
          "contextualTitle": "VAMP Vault"
        },
        {
          "id": "vampVault.views.credentials",
          "name": "Credentials",
          "contextualTitle": "VAMP Vault"
        }
      ]
    },
    "commands": [
      {
        "command": "vampVault.openBrowser",
        "title": "VAMP Vault: Browse Credentials",
        "icon": "$(book)"
      },
      {
        "command": "vampVault.addCredential",
        "title": "VAMP Vault: Add Credential",
        "icon": "$(add)"
      },
      {
        "command": "vampVault.createGroup",
        "title": "VAMP Vault: New Folder"
      },
      {
        "command": "vampVault.renameGroup",
        "title": "VAMP Vault: Rename Folder"
      },
      {
        "command": "vampVault.recycleGroup",
        "title": "VAMP Vault: Move Folder to Recycle Bin"
      },
      {
        "command": "vampVault.moveCredential",
        "title": "VAMP Vault: Move to Folder"
      },
      {
        "command": "vampVault.openDatabase",
        "title": "VAMP Vault: Open Existing Database",
        "icon": "$(folder-opened)"
      },
      {
        "command": "vampVault.setupCli",
        "title": "VAMP Vault: Set Up KeePassXC & VeraCrypt CLI"
      },
      {
        "command": "vampVault.createVault",
        "title": "VAMP Vault: Create Vault (KeePassXC .kdbx)"
      },
      {
        "command": "vampVault.openGuide",
        "title": "VAMP Vault: Open Guide"
      },
      {
        "command": "vampVault.status",
        "title": "VAMP Vault: Show Status"
      },
      {
        "command": "vampVault.lock",
        "title": "VAMP Vault: Lock (Forget Master Password)"
      },
      {
        "command": "vampVault.unlock",
        "title": "VAMP Vault: Unlock"
      },
      {
        "command": "vampVault.refreshTree",
        "title": "VAMP Vault: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "vampVault.revealKdbx",
        "title": "VAMP Vault: Reveal .kdbx File in OS File Explorer",
        "icon": "$(folder-opened)"
      },
      {
        "command": "vampVault.exportKdbx",
        "title": "VAMP Vault: Export .kdbx Copy to...",
        "icon": "$(cloud-download)"
      },
      {
        "command": "vampVault.searchCredentials",
        "title": "VAMP Vault: Search Credentials",
        "icon": "$(search)"
      },
      {
        "command": "vampVault.copyUsername",
        "title": "VAMP Vault: Copy Username",
        "icon": "$(person)"
      },
      {
        "command": "vampVault.copyPassword",
        "title": "VAMP Vault: Copy Password (Approval Required)",
        "icon": "$(key)"
      },
      {
        "command": "vampVault.showEntry",
        "title": "VAMP Vault: Show Entry Details",
        "icon": "$(list-unordered)"
      },
      {
        "command": "vampVault.changeApproval",
        "title": "VAMP Vault: Change Agent Approval Level",
        "icon": "$(shield)"
      },
      {
        "command": "vampVault.setupRemote",
        "title": "VAMP Vault: Set Up Remote Vault (SSH)",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "vampVault.verifyRemote",
        "title": "VAMP Vault: Verify Remote Vault",
        "icon": "$(check)"
      },
      {
        "command": "vampVault.createRemoteVault",
        "title": "VAMP Vault: Create Remote Vault (on the host)",
        "icon": "$(add)"
      },
      {
        "command": "vampVault.unlockRemote",
        "title": "VAMP Vault: Unlock Remote Vault",
        "icon": "$(unlock)"
      },
      {
        "command": "vampVault.lockRemote",
        "title": "VAMP Vault: Lock Remote Vault",
        "icon": "$(lock)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "vampVault.changeApproval",
          "when": "view == vampVault.views.status",
          "group": "navigation@0"
        },
        {
          "command": "vampVault.addCredential",
          "when": "view == vampVault.views.credentials",
          "group": "navigation@0"
        },
        {
          "command": "vampVault.openBrowser",
          "when": "view == vampVault.views.credentials",
          "group": "navigation@1"
        },
        {
          "command": "vampVault.refreshTree",
          "when": "view == vampVault.views.credentials",
          "group": "navigation@2"
        },
        {
          "command": "vampVault.searchCredentials",
          "when": "view == vampVault.views.credentials",
          "group": "navigation@3"
        },
        {
          "command": "vampVault.lock",
          "when": "view == vampVault.views.credentials && vampVault.unlocked",
          "group": "navigation@4"
        },
        {
          "command": "vampVault.unlock",
          "when": "view == vampVault.views.credentials && !vampVault.unlocked",
          "group": "navigation@4"
        },
        {
          "command": "vampVault.revealKdbx",
          "when": "view == vampVault.views.credentials",
          "group": "1_vault@1"
        },
        {
          "command": "vampVault.exportKdbx",
          "when": "view == vampVault.views.credentials",
          "group": "1_vault@2"
        },
        {
          "command": "vampVault.refreshTree",
          "when": "view == vampVault.views.status",
          "group": "navigation@1"
        },
        {
          "command": "vampVault.revealKdbx",
          "when": "view == vampVault.views.status",
          "group": "1_vault@1"
        },
        {
          "command": "vampVault.exportKdbx",
          "when": "view == vampVault.views.status",
          "group": "1_vault@2"
        },
        {
          "command": "vampVault.setupCli",
          "when": "view == vampVault.views.status",
          "group": "2_setup@1"
        },
        {
          "command": "vampVault.setupRemote",
          "when": "view == vampVault.views.status",
          "group": "2_setup@2"
        },
        {
          "command": "vampVault.verifyRemote",
          "when": "view == vampVault.views.status",
          "group": "navigation@4"
        },
        {
          "command": "vampVault.unlockRemote",
          "when": "view == vampVault.views.status",
          "group": "navigation@5"
        },
        {
          "command": "vampVault.lockRemote",
          "when": "view == vampVault.views.status",
          "group": "navigation@5"
        },
        {
          "command": "vampVault.setupRemote",
          "when": "view == vampVault.views.credentials",
          "group": "1_vault@3"
        },
        {
          "command": "vampVault.createRemoteVault",
          "when": "view == vampVault.views.credentials",
          "group": "1_vault@4"
        }
      ],
      "view/item/context": [
        {
          "command": "vampVault.addCredential",
          "when": "view == vampVault.views.credentials && viewItem == vampVault.group",
          "group": "1_folder@1"
        },
        {
          "command": "vampVault.createGroup",
          "when": "view == vampVault.views.credentials && viewItem == vampVault.group",
          "group": "1_folder@2"
        },
        {
          "command": "vampVault.renameGroup",
          "when": "view == vampVault.views.credentials && viewItem == vampVault.group",
          "group": "1_folder@3"
        },
        {
          "command": "vampVault.recycleGroup",
          "when": "view == vampVault.views.credentials && viewItem == vampVault.group",
          "group": "1_folder@4"
        },
        {
          "command": "vampVault.moveCredential",
          "when": "view == vampVault.views.credentials && viewItem == vampVault.credential",
          "group": "2_details@2"
        },
        {
          "command": "vampVault.copyUsername",
          "when": "view == vampVault.views.credentials && viewItem == vampVault.credential",
          "group": "1_copy@1"
        },
        {
          "command": "vampVault.copyPassword",
          "when": "view == vampVault.views.credentials && viewItem == vampVault.credential",
          "group": "1_copy@2"
        },
        {
          "command": "vampVault.showEntry",
          "when": "view == vampVault.views.credentials && viewItem == vampVault.credential",
          "group": "2_details@1"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "vamp.vault",
        "label": "VAMP Vault"
      }
    ],
    "configuration": {
      "title": "VAMP Vault",
      "properties": {
        "vampVault.deliveryTargets": {
          "type": "object",
          "default": {},
          "scope": "application",
          "description": "Named credential delivery destinations. Use an absolute executable and fixed args for local stdin, or configure SSH host, port, user, identityFile and verified knownHostsFile. A VM destination with vmId can also set guestVolume with entry, device and mountPoint for VeraCrypt."
        },
        "vampVault.keepassxcCliPath": {
          "type": "string",
          "default": "",
          "description": "Explicit path to keepassxc-cli. Empty means use the system installation when found, otherwise the copy downloaded into this extension's storage."
        },
        "vampVault.veracryptCliPath": {
          "type": "string",
          "default": "",
          "description": "Explicit path to the VeraCrypt command line binary. Empty means use the system installation when found, otherwise the copy downloaded into this extension's storage."
        },
        "vampVault.veracryptWslDistribution": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Installed WSL distribution with the VeraCrypt console CLI for creating managed volumes on Windows."
        },
        "vampVault.defaultKdbxPath": {
          "type": "string",
          "default": "",
          "description": "Default KeePassXC database (.kdbx) used by the vault tools. Empty means 'vault.kdbx' inside this extension's global storage."
        },
        "vampVault.defaultVolumePath": {
          "type": "string",
          "default": "",
          "description": "Default VeraCrypt volume (container file or device) used by the mount tools. Empty means 'vault.hc' inside this extension's global storage."
        },
        "vampVault.mountPoint": {
          "type": "string",
          "default": "",
          "description": "Default mount point for encrypted volumes. Empty means a per-user folder: a drive letter on Windows, a folder under the home directory on macOS and Linux."
        },
        "vampVault.sessionCacheMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 0,
          "maximum": 120,
          "description": "How long a retrieved credential stays in the MCP server's memory before it must be approved and read again. 0 disables caching."
        },
        "vampVault.autoDownloadCli": {
          "type": "boolean",
          "default": true,
          "description": "Allow the vault to download the official KeePassXC/VeraCrypt binaries for this platform when no system installation is found."
        },
        "vampVault.approvalMode": {
          "type": "string",
          "enum": [
            "each-read",
            "per-session",
            "off"
          ],
          "default": "per-session",
          "description": "When to ask you before a secret leaves the vault: on every read, once per entry per session, or never (off is not recommended)."
        },
        "vampVault.remote.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Keep a second, independent vault on a remote host, reached over SSH. Each host keeps its own database, master password and session cache; nothing is synced with the local vault or with another host."
        },
        "vampVault.remote.useVampRemoteSettings": {
          "type": "boolean",
          "default": true,
          "description": "Reuse the SSH connection details (host, port, username, private key, node path) from the VAMP extension's vamp.remote.* settings. The vault paths are never taken from there: which database a host owns is decided only by this extension."
        },
        "vampVault.remote.host": {
          "type": "string",
          "default": "",
          "description": "SSH host of the remote vault. Leave empty to reuse vamp.remote.host when vampVault.remote.useVampRemoteSettings is on."
        },
        "vampVault.remote.port": {
          "type": "number",
          "default": 22,
          "description": "SSH port of the remote host."
        },
        "vampVault.remote.username": {
          "type": "string",
          "default": "",
          "description": "SSH account on the remote host. Empty means the account in ~/.ssh/config."
        },
        "vampVault.remote.privateKeyPath": {
          "type": "string",
          "default": "",
          "description": "Private key used for SSH. Empty means your SSH agent or the default key."
        },
        "vampVault.remote.kdbxPath": {
          "type": "string",
          "default": "~/.vamp/vault/vault.kdbx",
          "description": "This host's own KeePassXC database, on that host's filesystem. A leading ~ is the remote account's home directory."
        },
        "vampVault.remote.volumePath": {
          "type": "string",
          "default": "~/.vamp/vault/vault.hc",
          "description": "This host's own VeraCrypt volume, on that host's filesystem."
        },
        "vampVault.remote.mountPoint": {
          "type": "string",
          "default": "~/.vamp/vault/mnt",
          "description": "Where the remote volume is mounted on that host."
        },
        "vampVault.remote.remoteNodePath": {
          "type": "string",
          "default": "node",
          "description": "Node.js binary on the remote host that runs the vault server."
        },
        "vampVault.remote.approvalMode": {
          "type": "string",
          "enum": [
            "each-read",
            "per-session",
            "off"
          ],
          "default": "per-session",
          "description": "When the agent must be approved on this computer before a read reaches the remote host. Kept separate from the local vault's approval mode."
        },
        "vampVault.mcpTarget": {
          "type": "string",
          "enum": [
            "local",
            "remote"
          ],
          "default": "local",
          "scope": "application",
          "markdownDescription": "Select the single VAMP Vault MCP target. Local is the default. Remote uses the existing vampVault.remote settings and must be enabled and configured; invalid settings never fall back to local. Local and remote sidebar operations remain separate. Changing this setting changes which vault the MCP client accesses; restart its server connection after switching."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "package": "npm run build && vsce package --no-dependencies --out vamp-vault-0.1.10.vsix",
    "test": "node build.mjs && node test/smoke.mjs && node test/extension-host.mjs && node test/remote.mjs && node --test test/browser.cjs",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.25.0"
  },
  "preview": false,
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  }
}
